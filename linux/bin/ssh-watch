#!/usr/bin/env python3
"""Live, compact view of SSH sessions on this machine (Hyper+4).

One line per active Tailscale SSH session (user, machine, tty, age, idle) with what it
is running underneath, then one line per recent connect/disconnect event.
"""
import json
import os
import re
import subprocess
import time
from datetime import datetime

B, D, C, Y, G, RED, R = "\033[1m", "\033[2m", "\033[36m", "\033[33m", "\033[32m", "\033[31m", "\033[0m"
REFRESH = 2
EVENTS = 6


def run(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def peer_names():
    """Tailscale IP -> machine name."""
    try:
        status = json.loads(run("tailscale", "status", "--json") or "{}")
    except json.JSONDecodeError:
        return {}
    return {ip: p.get("HostName", "?") for p in (status.get("Peer") or {}).values() for ip in p.get("TailscaleIPs", [])}


def processes():
    """pid -> dict(ppid, user, tty, etimes, stat, args)."""
    procs = {}
    for line in run("ps", "-eo", "pid=,ppid=,user=,tty=,etimes=,stat=,args=").splitlines():
        pid, ppid, user, tty, etimes, stat, args = (line.split(None, 6) + [""])[:7]
        procs[int(pid)] = dict(ppid=int(ppid), user=user, tty=tty, etimes=int(etimes), stat=stat, args=args)
    return procs


def descendants(procs, root):
    kids = {}
    for pid, p in procs.items():
        kids.setdefault(p["ppid"], []).append(pid)
    out, stack = [], [root]
    while stack:
        pid = stack.pop()
        out.append(pid)
        stack.extend(sorted(kids.get(pid, []), reverse=True))
    return out


def ago(seconds):
    seconds = int(seconds)
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m"
    return f"{seconds // 3600}h{seconds % 3600 // 60:02d}m"


def short(args, width=60):
    args = re.sub(r"^\S*/", "", args)  # drop the binary's directory
    return args if len(args) <= width else args[: width - 1] + "…"


def tty_idle(tty):
    try:
        return time.time() - os.stat(f"/dev/{tty}").st_atime
    except OSError:
        return None


def who_hosts():
    """tty -> remote IP, from utmp."""
    hosts = {}
    for line in run("who").splitlines():
        m = re.match(r"(\S+)\s+(\S+).*\(([\d.]+|[0-9a-f:]{4,})\)$", line)
        if m:
            hosts[m.group(2)] = m.group(3)
    return hosts


def activity(procs, pids, tty):
    """What the session is doing: tmux panes, or the foreground command."""
    lines = []
    if any(procs[p]["args"].startswith("tmux") for p in pids):
        fmt = "#{session_name}\t#{pane_current_command}"
        panes = [l.split("\t") for l in run("tmux", "list-panes", "-a", "-F", fmt).splitlines() if "\t" in l]
        for session, cmd in panes:
            lines.append(f"tmux {session}  → {cmd}")
    if not lines:
        fg = [p for p in pids if "+" in procs[p]["stat"]] or pids
        cmds = [procs[p]["args"] for p in fg if not procs[p]["args"].startswith(("login", "/usr/bin/login", "/usr/sbin/tailscaled", "-"))]
        if cmds:
            lines.append(short(cmds[-1]))
    return lines


def sessions(procs, names):
    ts = [pid for pid, p in procs.items() if p["args"].startswith("/usr/sbin/tailscaled") and p["ppid"] == 1]
    if not ts:
        return []
    hosts = who_hosts()
    out = []
    for root in sorted(pid for pid, p in procs.items() if p["ppid"] == ts[0]):
        pids = descendants(procs, root)
        users = [procs[p]["user"] for p in pids if procs[p]["user"] != "root"]
        tty = next((procs[p]["tty"] for p in pids if procs[p]["tty"] != "?"), None)
        ip = hosts.get(tty, "")
        out.append(dict(
            user=users[0] if users else "root",
            peer=names.get(ip, ip or "—"),
            tty=tty or "no tty",
            age=procs[root]["etimes"],
            idle=tty_idle(tty) if tty else None,
            doing=activity(procs, pids, tty),
        ))
    return out


def gpu(procs):
    """One summary line plus who is using GPU memory (btop has no per-process GPU view)."""
    q = run("nvidia-smi", "--query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu,power.draw",
            "--format=csv,noheader,nounits").strip().splitlines()
    if not q:
        return []
    name, util, used, total, temp, power = [x.strip() for x in q[0].split(",")]
    name = name.replace("NVIDIA GeForce ", "")
    lines = [f"{B}GPU{R}  {name}  {util}%  {float(used) / 1024:.1f}/{float(total) / 1024:.0f} GB  {temp}°C  {float(power):.0f} W"]
    apps = run("nvidia-smi", "--query-compute-apps=pid,used_memory", "--format=csv,noheader,nounits")
    for line in apps.strip().splitlines():
        pid, mem = [x.strip() for x in line.split(",")]
        p = procs.get(int(pid), {})
        lines.append(f"  {p.get('user', '?'):<9} {float(mem) / 1024:5.1f} GB  {D}{short(p.get('args', '?'), 50)}{R}")
    if len(lines) == 1:
        lines.append(f"  {D}no GPU jobs{R}")
    return lines


EVENT_RE = re.compile(r"^(\S+) .*?ssh-session\((\S+)\): (.*)$")


def events(names):
    log = run("journalctl", "-u", "tailscaled", "--since", "-7d", "-o", "short-iso", "--no-pager")
    who, out = {}, []
    for line in log.splitlines():
        m = EVENT_RE.match(line)
        if not m:
            continue
        stamp, sess, msg = m.groups()
        hhmm = datetime.fromisoformat(stamp).strftime("%a %b %d %H:%M")
        if c := re.search(r'new SSH connection from \S+ \(([^)]+)\) to ssh-user "([^"]+)"', msg):
            ip, user = c.groups()
            who[sess] = (user, names.get(ip, ip))
            out.append((hhmm, *who[sess], f"{G}connected{R}"))
        elif re.search(r"denied|rejected", msg, re.I):
            out.append((hhmm, *who.get(sess, ("?", "?")), f"{RED}denied{R}"))
        elif "Session complete" in msg:
            out.append((hhmm, *who.get(sess, ("?", "?")), f"{D}ended{R}"))
    return out[-EVENTS:][::-1]


def render():
    names = peer_names()
    procs = processes()
    lines = [f"{B}SSH{R}  {D}{time.strftime('%a %b %d  %H:%M:%S')}{R}", ""]
    active = sessions(procs, names)
    for s in active:
        idle = f"  idle {ago(s['idle'])}" if s["idle"] is not None else ""
        lines.append(f"{G}●{R} {B}{C}{s['user']:<9}{R} {Y}{s['peer']:<8}{R} {s['tty']:<7}  {ago(s['age'])}{D}{idle}{R}")
        lines += [f"    {D}{d}{R}" for d in s["doing"]]
    if not active:
        lines.append(f"{D}no active sessions{R}")
    lines += [""] + gpu(procs)
    lines += ["", f"{B}Recent{R}  {D}(7 days){R}"]
    ev = events(names)
    lines += [f"  {D}{t}{R}  {u:<9} {p:<8} {what}" for t, u, p, what in ev] or [f"  {D}none in the last 7 days{R}"]
    return "\n".join(lines)


def main():
    print("\033[?25l", end="")  # hide cursor
    try:
        while True:
            frame = render()
            print("\033[H\033[2J" + frame, flush=True)
            time.sleep(REFRESH)
    except KeyboardInterrupt:
        pass
    finally:
        print("\033[?25h", end="")


if __name__ == "__main__":
    main()
