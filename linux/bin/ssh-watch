#!/usr/bin/env bash
# Live dashboard of SSH sessions on this machine (Hyper+4).
# Shows who is connected over Tailscale SSH, what they're running, and recent SSH log events.

B=$'\e[1m' D=$'\e[2m' C=$'\e[36m' Y=$'\e[33m' G=$'\e[32m' R=$'\e[0m'

peer_name() {  # Tailscale IP -> machine name
  tailscale status --json 2>/dev/null |
    jq -r --arg ip "$1" '.Peer[] | select(.TailscaleIPs | index($ip)) | .HostName' | head -1
}

render() {
  printf '%sSSH sessions%s  %s%s%s\n\n' "$B" "$R" "$D" "$(date +%T)" "$R"
  local found=0
  # who: user tty date time (host) -- keep sessions whose host looks like an IP
  while read -r user tty day time host; do
    host=${host#(}; host=${host%)}
    # only remote logins (IPv4/IPv6 host), not the local X display or tmux panes
    [[ $host =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ || $host =~ ^[0-9a-f]*:[0-9a-f:]{3,}$ ]] || continue
    found=1
    local name idle
    name=$(peer_name "$host")
    idle=$(w -h "$user" 2>/dev/null | awk -v t="$tty" '$2==t {print $5}')
    printf '%s%s%s  %s  from %s%s%s (%s)  since %s  idle %s\n' \
      "$B$C" "$user" "$R" "$tty" "$Y" "${name:-?}" "$R" "$host" "$time" "${idle:--}"
    ps --forest -o etime=,args= -t "$tty" 2>/dev/null | sed "s/^/    /"
    # tmux started from this session: show what each pane is running
    if ps -o args= -t "$tty" | grep -q '^tmux'; then
      tmux -L default list-panes -a -F '    tmux #{session_name}:#{window_index}.#{pane_index}  #{pane_current_command}  #{pane_current_path}' 2>/dev/null
    fi
    echo
  done < <(who)
  (( found )) || printf '%sNo interactive SSH sessions.%s\n\n' "$G" "$R"

  # Everything Tailscale SSH has started, including non-terminal commands (scripts, agents)
  printf '%sAll SSH processes%s  %s(user, pid, command)%s\n' "$B" "$R" "$D" "$R"
  local ts
  ts=$(pgrep -xo tailscaled)
  if [[ -n $ts ]] && pgrep -P "$ts" >/dev/null; then
    for child in $(pgrep -P "$ts"); do
      pstree -a -u -p -l "$child" | cut -c1-150 | sed 's/^/  /'
    done
  else
    printf '  %snone%s\n' "$G" "$R"
  fi
  echo

  printf '%sRecent SSH events%s  %s(last 24h)%s\n' "$B" "$R" "$D" "$R"
  journalctl -u tailscaled --since '-24h' -o short --no-pager 2>/dev/null |
    grep -E 'new SSH connection|access granted|denied|rejected|Session complete' | tail -8 | sed -E 's/ [^ ]+ tailscaled\[[0-9]+\]://' | cut -c1-150 | sed "s/^/  $D/;s/$/$R/"
}

trap 'tput cnorm; exit' INT TERM
tput civis
while true; do
  out=$(render)
  clear
  printf '%s\n' "$out"
  sleep 2
done
